SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Vazio + DEBUG=True libera qualquer origem. Em produção, liste as origens do front-end.
CORS_ALLOWED_ORIGINS=
# Origens HTTPS confiáveis para o admin atrás de proxy (ex.: https://api.seudominio.com)
CSRF_TRUSTED_ORIGINS=
# True desativa o JWT em desenvolvimento: requisições sem token viram o usuário dev@example.com.
# Só funciona com DEBUG=True; nunca use em produção.
AUTH_DISABLED=False
# Vazio = SQLite local. Exemplo Postgres: postgres://user:senha@localhost:5432/banco
DATABASE_URL=
# Vazio = tarefas Celery rodam de forma síncrona (sem Redis).
# Para usar o Redis do docker-compose: `pdm run redis` e descomente a linha abaixo.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
