#!/bin/sh
# Bloqueia commit de arquivos .env (segredos). .env.example é permitido.
bloqueados=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..+)?$' | grep -vE '\.env\.example$')
if [ -n "$bloqueados" ]; then
  echo "Commit bloqueado: arquivo(s) de ambiente staged:" >&2
  echo "$bloqueados" | sed 's/^/  - /' >&2
  echo "Remova com: git restore --staged <arquivo>" >&2
  exit 1
fi
